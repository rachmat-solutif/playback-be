# Copy this file to .env.development and fill in values.
# Do NOT commit .env.development -- it may contain secrets in later phases.

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/childapp

# --- Microsoft Entra ID SSO ---
# AUTH_PROVIDER=entra
# ENTRA_CLIENT_ID=
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# ENTRA_LOGOUT_URI=http://localhost:3000/login
# SESSION_KEY=<run: openssl rand -hex 32>  # 32-byte hex AES key -- MUST be unique per env (dev/staging/prod); reuse lets dev leak forge prod session (session.ts:34)
# SESSION_PASSWORD=<run: openssl rand -base64 32>  # signing secret -- BOTH SESSION_* required for entra/dummy, missing either -> 401

# --- Azure Blob Storage for local-backed audio ---
# Use a real Azure Storage account with a manually created private container.
# The application never creates or changes the container.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=audio
# Azure Blob SAS token expiry window (5-60). Direct audio URLs use this lifetime.
# AUDIO_SAS_EXPIRY_MINUTES=60
# Clock-skew buffer so backdated SAS start time still validates (default 5).
# AUDIO_SAS_CLOCK_SKEW_MINUTES=5
# Remote audio download timeout in seconds before aborting (default 300).
# REMOTE_AUDIO_TIMEOUT_SECONDS=300
# Maximum redirect chain length for remote audio URLs (default 3).
# REMOTE_AUDIO_MAX_REDIRECTS=3
# --- FE/client origins for multi-client SSO (single BE serves multiple FEs) ---
# Comma-separated allowlist for FE-passed ?redirect. FE passes window.location.origin to GET /auth/login?redirect=...
# BE validates redirect origin is in this list (plus FRONTEND_URL fallback) and stores in session for /auth/callback.
# APP_ORIGINS=http://localhost:5173,http://localhost:5174,https://playback.rachmat.pro,https://playback-fe-staging.vercel.app
# FRONTEND_URL fallback when FE does not pass ?redirect (single-FE envs, deprecated for multi-client)
# FRONTEND_URL=http://localhost:5173

# --- Dummy auth (1-row seed, no Entra) ---
# New canonical seed: SEED_GUARD=SAYA_SADAR_DROPDB_$(date +%H:%M) npm run db:seed  -> Agent Dummy + Customer Dummy (+628123456789 via phone/call) + user/123456
# e.g. SEED_GUARD=SAYA_SADAR_DROPDB_14:05 npm run db:seed
# Login: POST /auth/login {username:"user", password:"123456"}  (AUTH_PROVIDER=dummy)
# AUTH_PROVIDER=dummy
# SESSION_KEY=<run: openssl rand -hex 32>  # required for dummy -- MUST be unique per env; do not copy staging/prod value
# SESSION_PASSWORD=<run: openssl rand -base64 32>  # both SESSION_* encrypt session cookie (userId/roles/pkce); reuse -> cross-env forgery
# Full dummy dataset (160): SEED_GUARD=SAYA_SADAR_DROPDB_$(date +%H:%M) npm run db:seed:dummy
# Guard password for all seeds: SAYA_SADAR_DROPDB_{HH}:{MM} e.g. SAYA_SADAR_DROPDB_14:05 (current time, or --guard=SAYA_SADAR_DROPDB_14:05). On invalid guard the correct value is shown.

# --- API Docs (Scalar) gated with Basic Auth ---
# Both /docs and /docs/json require Basic Auth; editable via Vercel env without code change
# DOCS_BASIC_USER=user123
# DOCS_BASIC_PASS=user123

# --- Offline dev: bypass auth (development/test only) ---
AUTH_BYPASS=true

# --- Script-only bulk import credential ---
# IMPORT_API_KEY=<staging key; never commit this value>


# Azure Blob SAS tokens have two time fields: st (start time) and ex (expiry). If the client's clock is behind the server's clock, a request could arrive "before" the SAS becomes valid and be rejected.
# The clock-skew buffer adds a grace period to the st time. With AUDIO_SAS_CLOCK_SKEW_MINUTES=5, the server generates the SAS with st set to 5 minutes in the past. So even if a client's clock is slightly behind, the current time still falls within [st, ex] and the token validates.
# It's a safety margin -- clocks on different machines are rarely perfectly synced.
