# Staging env for Vercel deployment: playback-be-staging.vercel.app
# Copy to Vercel Dashboard -> Settings -> Environment Variables (do NOT commit real values)
# Also used locally as .env.staging for staging parity testing

NODE_ENV=staging
PORT=3000

# MongoDB Atlas (M0 free tier)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Example: mongodb+srv://playback-staging:PASSWORD@playback-staging.xxxxx.mongodb.net/childapp?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/childapp?retryWrites=true&w=majority

# Auth -- choose entra (SSO) or dummy (1-row seed, no Entra)
# Entra (prior default):
# AUTH_PROVIDER=entra
# Dummy (new canonical 1-row seed: Agent Dummy + Customer Dummy +628123456789 via phone + user/123456):
AUTH_PROVIDER=dummy
# ENTRA_* required only when AUTH_PROVIDER=entra
ENTRA_CLIENT_ID=<application-client-id>
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_SECRET=<client-secret>
ENTRA_REDIRECT_URI=https://playback-be-staging.vercel.app/auth/callback
ENTRA_LOGOUT_URI=https://playback-be-staging.vercel.app/login
# Dummy login: POST /auth/login {username:"user", password:"123456"} -> session cookie
# Seeds are guarded: SEED_GUARD=SAYASADAR npm run db:seed (1-row) or npm run db:seed:dummy (160)

# Session secrets (generate once per environment, never reuse across envs)
# SESSION_KEY: openssl rand -hex 32  (64 hex chars, 32 bytes)
# SESSION_PASSWORD: openssl rand -base64 32
SESSION_KEY=<64-hex-chars>
SESSION_PASSWORD=<base64-secret>

# Azure Blob Storage (private container, SAS URLs)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_CONTAINER=audio
AUDIO_SAS_EXPIRY_MINUTES=60
AUDIO_SAS_CLOCK_SKEW_MINUTES=5
REMOTE_AUDIO_TIMEOUT_SECONDS=300
REMOTE_AUDIO_MAX_REDIRECTS=3

# CORS / allowed origins (Vercel staging domain + local if needed)
# For BE-only staging, set to the exact Vercel URL. If FE is separate, add its origin comma-separated.
APP_ORIGINS=https://playback-be-staging.vercel.app

# Optional
IMPORT_API_KEY=<32-plus-char-bearer-token>
LOG_LEVEL=info
SERVICE_NAME=playback-server
