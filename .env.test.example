# Test env -- isolated from dev dummy data (childapp_test)
# Copy to .env.test:  cp .env.test.example .env.test
# Or run one-off:  MONGO_URI=mongodb://localhost:27017/childapp_test npm run test:server
# Required: local MongoDB running (docker compose up -d) and MONGO_URI reachable
# No auth needed -- tests run with disableAuth:true (setup.ts), so ENTRA/dummy/SESSION/Blob not required

NODE_ENV=test
MONGO_URI=mongodb://localhost:27017/childapp_test
# Docs Basic Auth (not needed in tests -- buildApp({disableAuth:true}) skips docs gate, but set for local parity)
# DOCS_BASIC_USER=user123
# DOCS_BASIC_PASS=user123

# Optional -- reduce log noise during tests
# LOG_LEVEL=error
